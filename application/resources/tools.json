[
  {
    "type": "function",
    "function": {
      "name": "get_news",
      "description": "Получить последние новости MineBridge (макс 20)",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Количество новостей (макс 20)",
            "default": 10
          },
          "offset": {
            "type": "integer",
            "description": "Смещение для пагинации",
            "default": 0
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "web_search",
      "description": "Поиск в интернете для получения актуальной информации",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Текст поискового запроса"
          },
          "max_results": {
            "type": "integer",
            "description": "Максимум результатов (<=10)",
            "default": 5
          }
        },
        "required": ["query"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "add_sticker",
      "description": "Добавить стикер и сгенерировать короткое описание на русском (2-4 слова)",
      "parameters": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Краткое описание на русском (2-4 слова), например: 'грустный кот'"
          },
          "message_id": {
            "type": "integer",
            "description": "ID сообщения Telegram со стикером"
          }
        },
        "required": ["description", "message_id"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "rename_sticker",
      "description": "Переименовать существующий стикер (по имени или по ID сообщения)",
      "parameters": {
        "type": "object",
        "properties": {
          "old_name": {
            "type": "string",
            "description": "Текущее имя стикера (не нужен при message_id)"
          },
          "new_name": {
            "type": "string",
            "description": "Новое краткое имя на русском (2-4 слова)"
          },
          "message_id": {
            "type": "integer",
            "description": "ID сообщения Telegram (не нужен при old_name)"
          }
        },
        "required": ["new_name"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "save_memory",
      "description": "Сохранить информацию в память (chat или user) нейтральным тоном",
      "parameters": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": ["chat", "user"],
            "description": "Тип памяти: 'chat' — локальные мемы/события, 'user' — личная информация"
          },
          "content": {
            "type": "string",
            "description": "Что запомнить (коротко, нейтрально)"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Теги для поиска (имена, ключевые слова, даты)"
          }
        },
        "required": ["scope", "content"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_memory",
      "description": "Обновить запись в памяти (поиск и правка существующей записи)",
      "parameters": {
        "type": "object",
        "properties": {
          "search_query": {
            "type": "string",
            "description": "Запрос для поиска записи, которую нужно обновить"
          },
          "scope": {
            "type": "string",
            "enum": ["chat", "user"],
            "description": "Где искать: 'chat' или 'user' (опционально)"
          },
          "content": {
            "type": "string",
            "description": "Новое содержание (опционально, оставить пустым чтобы сохранить текущее)"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Новые теги (опционально)"
          }
        },
        "required": ["search_query"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "delete_memory",
      "description": "Удалить запись памяти по запросу",
      "parameters": {
        "type": "object",
        "properties": {
          "search_query": {
            "type": "string",
            "description": "Запрос для поиска записи, которую нужно удалить"
          },
          "scope": {
            "type": "string",
            "enum": ["chat", "user"],
            "description": "Где искать: 'chat' или 'user' (опционально)"
          }
        },
        "required": ["search_query"]
      }
    }
  }
]
